generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// UUID primary keys are v7, generated by Prisma Client (Postgres 16 has no native uuidv7),
// so the tables carry no DB-side default for them.

enum EmailTokenType {
  verify
  reset
}

enum ProjectRole {
  editor
  viewer
}

enum SnapshotKind {
  auto
  named
  pre_restore
  pre_bulk_delete
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Always stored normalized (trimmed and lowercased) so the unique index is case-insensitive.
  email           String    @unique
  name            String
  passwordHash    String    @map("password_hash")
  isAdmin         Boolean   @default(false) @map("is_admin")
  isSuperadmin    Boolean   @default(false) @map("is_superadmin")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  sessions         Session[]
  emailTokens      EmailToken[]
  createdProjects  Project[]           @relation("ProjectCreatedBy")
  memberships      ProjectMember[]
  invitationsSent  ProjectInvitation[] @relation("InvitationInvitedBy")
  createdSnapshots ProjectSnapshot[]   @relation("SnapshotCreatedBy")

  @@map("users")
}

model Session {
  /// SHA-256 hash of the session token; the raw token only lives in the cookie.
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EmailTokenType
  tokenHash String         @map("token_hash")
  expiresAt DateTime       @map("expires_at") @db.Timestamptz
  usedAt    DateTime?      @map("used_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("email_tokens")
}

model Project {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  diagram   Json     @db.JsonB
  version   BigInt   @default(0)
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  creator     User?               @relation("ProjectCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  members     ProjectMember[]
  invitations ProjectInvitation[]
  snapshots   ProjectSnapshot[]

  @@map("projects")
}

model ProjectMember {
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

model ProjectInvitation {
  id         String      @id @default(uuid(7)) @db.Uuid
  projectId  String      @map("project_id") @db.Uuid
  /// Always stored normalized (trimmed and lowercased), like User.email.
  email      String
  role       ProjectRole
  tokenHash  String      @map("token_hash")
  invitedBy  String?     @map("invited_by") @db.Uuid
  expiresAt  DateTime    @map("expires_at") @db.Timestamptz
  acceptedAt DateTime?   @map("accepted_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviter User?   @relation("InvitationInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("project_invitations")
}

model ProjectSnapshot {
  id        String       @id @default(uuid(7)) @db.Uuid
  projectId String       @map("project_id") @db.Uuid
  diagram   Json         @db.JsonB
  version   BigInt
  kind      SnapshotKind @default(auto)
  name      String?
  createdBy String?      @map("created_by") @db.Uuid
  authors   Json         @default("[]") @db.JsonB
  sizeBytes Int?         @map("size_bytes")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User?   @relation("SnapshotCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, kind])
  @@map("project_snapshots")
}
