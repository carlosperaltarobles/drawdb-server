# Local PostgreSQL database. Apply the schema once with `npm run migrate:dev`.
DATABASE_URL=postgres://drawdb:drawdb_local@localhost:5432/drawdb
APP_URL=http://localhost:5173
ALLOWED_EMAIL_DOMAINS=example.com

# Optional bootstrap administrator. Use a strong password outside local development.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Local Mailpit SMTP listener (start Mailpit on port 1026 to test email).
MAIL_HOST=localhost
MAIL_PORT=1026
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=DrawDB <noreply@localhost>

PORT=5000
NODE_ENV=dev
# Optional, used only by the legacy GitHub Gist endpoint.
GITHUB_TOKEN=
