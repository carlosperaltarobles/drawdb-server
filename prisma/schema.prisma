generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// UUID primary keys are v7, generated by Prisma Client (Postgres 16 has no native uuidv7),
// so the tables carry no DB-side default for them.

enum EmailTokenType {
  verify
  reset
}

enum ProjectRole {
  editor
  viewer
}

enum SnapshotKind {
  auto
  named
  pre_restore
  pre_bulk_delete
  pre_ai_apply
}

enum AiMessageRole {
  user
  assistant
}

enum AiMessageStatus {
  pending
  complete
  failed
  cancelled
}

enum AiGenerationStatus {
  pending
  running
  complete
  failed
  cancelled
}

enum AiProposalStatus {
  pending
  superseded
  discarded
  applied
  expired
}


model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Always stored normalized (trimmed and lowercased) so the unique index is case-insensitive.
  email           String    @unique
  name            String
  passwordHash    String    @map("password_hash")
  isAdmin         Boolean   @default(false) @map("is_admin")
  isSuperadmin    Boolean   @default(false) @map("is_superadmin")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  sessions         Session[]
  emailTokens      EmailToken[]
  createdProjects  Project[]           @relation("ProjectCreatedBy")
  memberships      ProjectMember[]
  invitationsSent  ProjectInvitation[] @relation("InvitationInvitedBy")
  createdSnapshots ProjectSnapshot[]   @relation("SnapshotCreatedBy")
  aiConversations  AiConversation[]
  aiGenerations    AiGeneration[]
  aiProposals      AiProposal[]

  @@map("users")

}

model Session {
  /// SHA-256 hash of the session token; the raw token only lives in the cookie.
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EmailTokenType
  tokenHash String         @map("token_hash")
  expiresAt DateTime       @map("expires_at") @db.Timestamptz
  usedAt    DateTime?      @map("used_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("email_tokens")
}

model Project {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  diagram   Json     @db.JsonB
  version   BigInt   @default(0)
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  creator         User?               @relation("ProjectCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  members         ProjectMember[]
  invitations     ProjectInvitation[]
  snapshots       ProjectSnapshot[]
  aiConversations AiConversation[]
  aiGenerations   AiGeneration[]
  aiProposals     AiProposal[]

  @@map("projects")

}

model ProjectMember {
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

model ProjectInvitation {
  id         String      @id @default(uuid(7)) @db.Uuid
  projectId  String      @map("project_id") @db.Uuid
  /// Always stored normalized (trimmed and lowercased), like User.email.
  email      String
  role       ProjectRole
  tokenHash  String      @map("token_hash")
  invitedBy  String?     @map("invited_by") @db.Uuid
  expiresAt  DateTime    @map("expires_at") @db.Timestamptz
  acceptedAt DateTime?   @map("accepted_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviter User?   @relation("InvitationInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("project_invitations")
}

model ProjectSnapshot {
  id        String       @id @default(uuid(7)) @db.Uuid
  projectId String       @map("project_id") @db.Uuid
  diagram   Json         @db.JsonB
  version   BigInt
  kind      SnapshotKind @default(auto)
  name      String?
  createdBy String?      @map("created_by") @db.Uuid
  authors   Json         @default("[]") @db.JsonB
  sizeBytes Int?         @map("size_bytes")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator     User?        @relation("SnapshotCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  aiProposals AiProposal[] @relation("ProposalSnapshot")

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, kind])
  @@map("project_snapshots")
}

model AiConversation {
  id            String   @id @default(uuid(7)) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  selectedModel String?  @map("selected_model")
  title         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AiMessage[]
  generations AiGeneration[]
  proposals   AiProposal[]

  @@index([projectId, userId, updatedAt(sort: Desc)])
  @@index([updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String          @id @default(uuid(7)) @db.Uuid
  conversationId String          @map("conversation_id") @db.Uuid
  role           AiMessageRole
  content        String
  status         AiMessageStatus @default(pending)
  requestedModel String?         @map("requested_model")
  reportedModel  String?         @map("reported_model")
  usage          Json?           @db.JsonB
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  generations  AiGeneration[] @relation("GenerationAssistantMessage")

  @@index([conversationId, createdAt(sort: Asc), id(sort: Asc)])
  @@map("ai_messages")
}

model AiGeneration {
  id                 String             @id @default(uuid(7)) @db.Uuid
  conversationId     String             @map("conversation_id") @db.Uuid
  projectId          String             @map("project_id") @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  requestId          String             @map("request_id") @db.Uuid
  status             AiGenerationStatus @default(pending)
  requestedModel     String             @map("requested_model")
  reportedModel      String?            @map("reported_model")
  assistantMessageId String             @map("assistant_message_id") @db.Uuid
  proposalId         String?            @map("proposal_id") @db.Uuid
  errorCode          String?            @map("error_code")
  continuation       Json?              @db.JsonB
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  conversation     AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assistantMessage AiMessage      @relation("GenerationAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: Cascade)
  proposal         AiProposal?    @relation("GenerationProposal", fields: [proposalId], references: [id], onDelete: SetNull)

  @@unique([conversationId, userId, requestId])
  @@index([projectId, userId, status])
  @@index([conversationId, status])
  @@map("ai_generations")
}

model AiProposal {
  id             String           @id @default(uuid(7)) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  projectId      String           @map("project_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  revision       Int
  requestedModel String           @map("requested_model")
  reportedModel  String?          @map("reported_model")
  baseDiagram    Json             @map("base_diagram") @db.JsonB
  afterDiagram   Json             @map("after_diagram") @db.JsonB
  ops            Json             @db.JsonB
  baseVersion    BigInt           @map("base_version")
  baseHash       String           @map("base_hash")
  status         AiProposalStatus @default(pending)
  summary        Json             @db.JsonB
  warnings       Json             @default("[]") @db.JsonB
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz
  appliedVersion BigInt?          @map("applied_version")
  snapshotId     String?          @map("snapshot_id") @db.Uuid
  appliedResult  Json?            @map("applied_result") @db.JsonB
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  conversation AiConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshot     ProjectSnapshot? @relation("ProposalSnapshot", fields: [snapshotId], references: [id], onDelete: SetNull)
  generations  AiGeneration[]   @relation("GenerationProposal")

  @@unique([conversationId, revision])
  @@index([conversationId, status])
  @@index([status, expiresAt])
  @@index([projectId, userId, createdAt(sort: Desc)])
  @@map("ai_proposals")
}

